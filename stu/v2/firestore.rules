rules_version = '2';

/* ============================================================
   S:NOW v2 — Firestore 보안 규칙

   설계 원칙
   1) 권한은 서버에서만 판정한다. 클라이언트 코드는 화면만 그린다.
   2) 학교 도메인 확인은 "최소 조건"일 뿐이다. 학생도 같은 도메인이므로
      담임·반장·관리자 여부는 반드시 users/{email} 문서로 확인한다.
   3) 모든 create 는 필드 목록·타입·길이·작성자·시각을 검증한다.

   Cloud Functions 없이 동작합니다. 규칙 안에서 users 문서를 읽으므로
   요청당 문서 읽기 1회가 추가되지만, 같은 요청 안에서는 캐시됩니다.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── 기본 ────────────────────────────────────────── */
    function t()        { return request.auth.token; }
    function signedIn() { return request.auth != null && t().email_verified == true; }
    function school()   { return signedIn() && t().email.matches('.*@sungil-i[.]kr$'); }

    function meRef()    { return /databases/$(database)/documents/users/$(t().email); }
    function known()    { return school() && exists(meRef()); }
    function me()       { return get(meRef()).data; }

    function has(p)     { return known() && me().privilege is list && (p in me().privilege); }
    function isSuper()  { return has('총관리자'); }
    function isAdmin()  { return isSuper() || has('관리자'); }
    function isTeacher(){ return known() && me().role == '교사'; }
    function myClass()  { return known() ? me().classKey : '__none__'; }
    function myNumber() { return known() ? me().number : -1; }

    /* ── 피드 문서 검증 ──────────────────────────────── */
    function allowedKeys() {
      return ['title','content','tags','important','students',
              'authorName','authorEmail','createdAt','updatedAt'];
    }

    function validText(d) {
      return d.title is string   && d.title.size()   > 0 && d.title.size()   <= 100
          && d.content is string && d.content.size() > 0 && d.content.size() <= 3000
          && (!('tags' in d.keys())     || (d.tags is list     && d.tags.size()     <= 12))
          && (!('students' in d.keys()) || (d.students is list && d.students.size() <= 60))
          && (!('important' in d.keys()) || d.important is bool);
    }

    function validCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(allowedKeys())
          && d.keys().hasAll(['title','content','authorName','authorEmail','createdAt'])
          && validText(d)
          && d.authorName is string && d.authorName.size() <= 40
          && d.authorEmail == t().email          // 작성자 위조 차단
          && d.createdAt == request.time;        // serverTimestamp() 강제
    }

    function validEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
              .hasOnly(['title','content','tags','important','students','updatedAt'])
          && validText(d)
          && d.updatedAt == request.time;
    }

    /* ── 전체 피드 ───────────────────────────────────── */
    match /feeds/{docId} {
      allow read:   if known();
      allow create: if isAdmin() && validCreate();
      allow update: if isAdmin() && validEdit();
      allow delete: if isAdmin();
    }

    /* ── 반별 피드 ───────────────────────────────────── */
    match /classFeeds/{classKey}/items/{docId} {
      function mine()   { return classKey == myClass(); }
      function writer() { return mine() && (has('담임') || has('반장') || has('부반장')); }

      // 우리 반 학생·담임, 교사, 관리자만 열람
      allow read: if known() && (mine() || isTeacher() || isAdmin());

      allow create: if (writer() || isAdmin()) && validCreate();
      allow update: if (writer() || isAdmin()) && validEdit();
      allow delete: if  writer() || isAdmin();

      // 학생 확인 처리: 우리 반 학생이 "자기 번호 하나만" 뺄 수 있음
      allow update: if known() && mine()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
        && request.resource.data.students == resource.data.students.removeAll([myNumber()]);
    }

    /* ── 대외 피드 (로그인 없이 열람 가능) ───────────── */
    match /externalFeeds/{docId} {
      allow read:   if true;
      allow create: if isAdmin() && validCreate();
      allow update: if isAdmin() && validEdit();
      allow delete: if isAdmin();
    }

    /* ── 명부 / 권한 ─────────────────────────────────── */
    match /users/{email} {

      function validUser() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','role','grade','class','classKey','number','privilege','updatedAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 40
            && d.role in ['학생','교사']
            && (!('privilege' in d.keys()) || (d.privilege is list && d.privilege.size() <= 6))
            && (!('classKey' in d.keys())  || (d.classKey is string && d.classKey.size() <= 6))
            && (!('number' in d.keys())    || d.number is number);
      }

      // 본인 문서는 존재 여부와 무관하게 읽을 수 있어야 합니다.
      // (명부에 없는 계정에게 "등록되지 않음"을 알려주기 위해)
      allow get: if (school() && t().email == email)
                 || (known() && (isTeacher() || isAdmin()));

      // 목록 조회는 "같은 반" 또는 교사·관리자만.
      // list 규칙은 결과 문서마다 평가되므로, 다른 반을 조회하면 거부됩니다.
      allow list: if known()
                  && (isTeacher() || isAdmin() || resource.data.classKey == myClass());

      // 명부 수정은 총관리자만 (관리 콘솔에서)
      allow create, update: if isSuper() && validUser();
      allow delete:         if isSuper();
    }

    /* 위에 명시되지 않은 모든 경로는 거부됩니다. */
  }
}
