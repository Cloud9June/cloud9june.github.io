rules_version = '2';

/* ============================================================
   S:NOW v2.1 — Firestore 보안 규칙

   설계 원칙
   1) 권한은 서버에서만 판정한다. 클라이언트 코드는 화면만 그린다.
   2) 학교 도메인 확인은 "최소 조건"일 뿐이다. 학생도 같은 도메인이므로
      담임·반장·관리자 여부는 반드시 users/{email} 문서로 확인한다.
   3) 본인 등록은 허용하되, 권한(privilege)은 절대 스스로 못 준다.
   4) 교사 역할은 총관리자 승인(status: active) 전에는 효력이 없다.

   v2.1 에서 달라진 것
   - 본인이 users/{email} 을 "최초 1회" 만들 수 있음 (allow create)
     · privilege 는 반드시 빈 배열
     · 학생은 즉시 active, 교사는 pending 으로만 만들어짐
     · 이미 문서가 있으면 create 는 실패하므로 자동으로 잠김
   - status 가 pending 인 사용자는 반별 피드·교사 권한이 모두 막힘
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── 기본 ────────────────────────────────────────── */
    function t()        { return request.auth.token; }
    function signedIn() { return request.auth != null && t().email_verified == true; }
    function school()   { return signedIn() && t().email.matches('.*@sungil-i[.]kr$'); }

    function meRef()    { return /databases/$(database)/documents/users/$(t().email); }
    function known()    { return school() && exists(meRef()); }
    function meMap()    { return get(meRef()).data; }

    /* status 가 없는 옛 문서는 active 로 봅니다 (하위 호환) */
    function active()   { return known() && meMap().get('status', 'active') == 'active'; }

    function privs()    { return active() ? meMap().get('privilege', []) : []; }
    function has(p)     { return p in privs(); }
    function isSuper()  { return has('총관리자'); }
    function isAdmin()  { return isSuper() || has('관리자'); }
    function isTeacher(){ return active() && meMap().get('role', '학생') == '교사'; }
    function myClass()  { return active() ? meMap().get('classKey', '__none__') : '__none__'; }
    function myNumber() { return active() ? meMap().get('number', -1) : -1; }

    /* ── 피드 문서 검증 ──────────────────────────────── */
    function allowedKeys() {
      return ['title','content','tags','important','students',
              'authorName','authorEmail','createdAt','updatedAt'];
    }

    function validText(d) {
      return d.title is string   && d.title.size()   > 0 && d.title.size()   <= 100
          && d.content is string && d.content.size() > 0 && d.content.size() <= 3000
          && (!('tags' in d)      || (d.tags is list     && d.tags.size()     <= 12))
          && (!('students' in d)  || (d.students is list && d.students.size() <= 60))
          && (!('important' in d) || d.important is bool);
    }

    function validCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(allowedKeys())
          && d.keys().hasAll(['title','content','authorName','authorEmail','createdAt'])
          && validText(d)
          && d.authorName is string && d.authorName.size() <= 40
          && d.authorEmail == t().email          // 작성자 위조 차단
          && d.createdAt == request.time;        // serverTimestamp() 강제
    }

    function validEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
              .hasOnly(['title','content','tags','important','students','updatedAt'])
          && validText(d)
          && d.updatedAt == request.time;
    }

    /* ── 전체 피드 ───────────────────────────────────── */
    match /feeds/{docId} {
      allow read:   if known();          // 승인 대기 중이어도 전체 공지는 봅니다
      allow create: if isAdmin() && validCreate();
      allow update: if isAdmin() && validEdit();
      allow delete: if isAdmin();
    }

    /* ── 반별 피드 ───────────────────────────────────── */
    match /classFeeds/{classKey}/items/{docId} {
      function mine()   { return classKey == myClass(); }
      function writer() { return mine() && (has('담임') || has('반장') || has('부반장')); }

      // active 인 우리 반 학생·담임, 교사, 관리자만 열람
      allow read: if active() && (mine() || isTeacher() || isAdmin());

      allow create: if (writer() || isAdmin()) && validCreate();
      allow update: if (writer() || isAdmin()) && validEdit();
      allow delete: if  writer() || isAdmin();

      // 학생 확인 처리: 우리 반 학생이 "자기 번호 하나만" 뺄 수 있음
      allow update: if active() && mine()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
        && request.resource.data.students == resource.data.students.removeAll([myNumber()]);
    }

    /* ── 대외 피드 (로그인 없이 열람 가능) ───────────── */
    match /externalFeeds/{docId} {
      allow read:   if true;
      allow create: if isAdmin() && validCreate();
      allow update: if isAdmin() && validEdit();
      allow delete: if isAdmin();
    }

    /* ── 명부 / 권한 ─────────────────────────────────── */
    match /users/{email} {

      function isMe() { return school() && t().email == email; }
      function d()    { return request.resource.data; }

      function userKeys() {
        return ['name','role','grade','class','classKey','number',
                'privilege','status','selfRegistered','createdAt','updatedAt'];
      }

      /* 본인 최초 등록.
         create 는 문서가 없을 때만 성공하므로 "1회 제한"이 자동으로 걸립니다. */
      function selfRegister() {
        return d().keys().hasOnly(userKeys())
            && d().keys().hasAll(['name','role','privilege','status','selfRegistered','createdAt'])
            && d().name is string && d().name.size() > 0 && d().name.size() <= 20
            && d().privilege == []                 // ★ 권한 자가 부여 차단
            && d().selfRegistered == true
            && d().createdAt == request.time
            && (
                 // 학생: 학년·반·번호 필수, 즉시 활성
                 (d().role == '학생'
                   && d().status == 'active'
                   && d().grade is number  && d().grade  >= 1 && d().grade  <= 3
                   && d().class is number  && d().class  >= 1 && d().class  <= 12
                   && d().number is number && d().number >= 1 && d().number <= 60
                   && d().classKey == string(int(d().grade)) + '-' + string(int(d().class)))
                 ||
                 // 교사: 승인 대기로만 생성. 번호는 없음.
                 (d().role == '교사'
                   && d().status == 'pending'
                   && !('number' in d())
                   && (!('grade' in d()) || (d().grade is number && d().grade >= 1 && d().grade <= 3))
                   && (!('class' in d()) || (d().class is number && d().class >= 1 && d().class <= 12)))
               );
      }

      /* 총관리자가 만들거나 고칠 때 */
      function adminShape() {
        return d().keys().hasOnly(userKeys())
            && d().name is string && d().name.size() > 0 && d().name.size() <= 40
            && d().role in ['학생','교사']
            && (!('privilege' in d()) || (d().privilege is list && d().privilege.size() <= 6))
            && (!('classKey' in d())  || (d().classKey is string && d().classKey.size() <= 6))
            && (!('number' in d())    || d().number is number)
            && (!('status' in d())    || d().status in ['active','pending']);
      }

      // 본인 문서는 존재 여부와 무관하게 읽을 수 있어야 합니다.
      // (등록 화면을 띄우려면 "없다"는 것을 알아야 합니다)
      allow get: if isMe() || (active() && (isTeacher() || isAdmin()));

      // 목록 조회는 같은 반 또는 교사·관리자만.
      // list 규칙은 결과 문서마다 평가되므로 다른 반을 조회하면 거부됩니다.
      allow list: if active()
                  && (isTeacher() || isAdmin() || resource.data.classKey == myClass());

      allow create: if (isMe() && selfRegister()) || (isSuper() && adminShape());
      allow update: if isSuper() && adminShape();   // 본인 수정 불가 — 잠김
      allow delete: if isSuper();
    }

    /* 위에 명시되지 않은 모든 경로는 거부됩니다. */
  }
}
