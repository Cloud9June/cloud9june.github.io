rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 전체관리자인지 확인하는 함수 (기존과 동일)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in get(/databases/$(database)/documents/settings/admin_list).data.emails;
    }

    // 2. 이 실습실(labId)의 담당 선생님인지 확인하는 함수.
    //    labs/{labId} 문서가 아직 없거나 managers 필드가 없으면 "담당자 없음"으로 취급한다.
    function isLabManager(labId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/labs/$(labId)) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/labs/$(labId)).data.get('managers', []);
    }

    // 3. 전체관리자 또는 이 실습실 담당 선생님이면 true
    function canManageLab(labId) {
      return isAdmin() || isLabManager(labId);
    }

    // 3-1. "어떤 실습실이든" 담당 선생님으로 등록되어 있는지 확인하는 함수.
    //      실습실이 16개라 하나하나 조회할 수 없으므로, settings/lab_managers에
    //      미리 모아둔 전체 담당자 이메일 목록(앱이 담당자를 저장할 때마다 동기화)으로 판단한다.
    function isAnyLabManager() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/settings/lab_managers) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/settings/lab_managers).data.get('emails', []);
    }

    // 4. 관리자 명단 (settings/admin_list) - 기존과 동일
    match /settings/admin_list {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4-1. 담당자 전용 공지 (실습실 종합 현황에만 표시) - 작성은 전체관리자만,
    //      열람은 전체관리자 + 실습실 담당 선생님만 가능 (학생·일반 방문자는 볼 수 없음)
    match /settings/dashboard_notice {
      allow read: if isAdmin() || isAnyLabManager();
      allow write: if isAdmin();
    }

    // 4-2. "전체 담당자 이메일" 집계 문서 - isAnyLabManager()가 내부적으로만 참조하며,
    //      클라이언트가 직접 읽을 일은 없으므로 전체관리자만 읽고 쓸 수 있게 한다.
    match /settings/lab_managers {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. 실습실 문서 (description, timeSlots, notice, managers, specs)
    match /labs/{labId} {
      allow read: if true;

      // 새로 만드는 경우(create): notice/managers 필드를 같이 보내지만 않으면
      // 담당 선생님도 만들 수 있다 (예: 담당 실습실 설명·사양을 처음 입력할 때).
      allow create: if canManageLab(labId) &&
        (isAdmin() ||
          (!('notice' in request.resource.data) &&
           !('managers' in request.resource.data)));

      // 수정하는 경우(update): notice / managers 값 자체가 바뀌는 요청은
      // 전체관리자가 아니면 거부한다.
      // (description, timeSlots, specs는 해당 실습실 담당 선생님도 가능 — 좌석과 같은 등급)
      allow update: if canManageLab(labId) &&
        (isAdmin() ||
          (!('notice' in request.resource.data.diff(resource.data).affectedKeys()) &&
           !('managers' in request.resource.data.diff(resource.data).affectedKeys())));

      allow delete: if isAdmin();

      // 6. 좌석 - 담당 선생님도 전체관리자와 동일하게 상태를 바꿀 수 있다.
      match /seats/{seatId} {
        allow read: if true;
        allow write: if canManageLab(labId);
      }

      // 7. 설치 프로그램 목록 - 담당 선생님도 전체관리자와 동일하게 추가/삭제할 수 있다.
      match /programs/{programId} {
        allow read: if true;
        allow write: if canManageLab(labId);
      }
    }

    // 8. 그 외 모든 데이터 (여기에 명시적으로 나열되지 않은 모든 경로)는 기본적으로
    //    전체관리자만 읽고 쓸 수 있다.
    //    ⚠️ 예전에는 이 마지막 규칙이 "allow read: if true"였다. Firestore 규칙은 같은 경로에
    //    맞는 여러 match 블록이 있으면 그중 하나라도 허용하면 통과되는 방식(OR)이라, 특정 경로에
    //    더 제한적인 규칙을 따로 추가해도 이 마지막 규칙이 "누구나 읽기 가능"을 계속 허용해버려서
    //    "담당자 전용 공지"를 진짜로 비공개로 만들 수 없었다. 그래서 이번에 기본값을
    //    전체관리자 전용으로 좁혔다. settings/admin_list, labs/**, seats/**, programs/** 는
    //    전부 위에서 이미 자기 자신의 "allow read: if true"를 따로 가지고 있으므로 이 변경으로
    //    기존에 동작하던 화면은 전혀 영향받지 않는다.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
